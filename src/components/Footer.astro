---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="footer-title">Maxwell Web Ops</p>
      <p class="footer-tagline">
        Web infrastructure, domain administration, and local visibility for small businesses in Fort Wayne &amp; Northeast Indiana.
      </p>
    </div>

    <div class="footer-links">
      <a href="/services">Services</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {currentYear} Maxwell Web Ops. Fort Wayne, Indiana.</p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
    padding-block: 2.5rem 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .footer-title {
    color: var(--color-text);
    font-weight: 700;
    font-size: 1rem;
    margin: 0 0 0.375rem;
  }

  .footer-tagline {
    margin: 0;
    max-width: 34rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .footer-links a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  .footer-bottom {
    padding-top: 1.25rem;
    font-size: 0.85rem;
  }

  .footer-bottom p {
    margin: 0;
  }
</style>