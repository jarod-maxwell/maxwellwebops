---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Inquiry Received | Maxwell Web Ops"
  description="Thank you for contacting Maxwell Web Ops. Your message has been received and will be reviewed within one business day."
  noindex={true}
>
  <main>
    <!-- Page Header -->
    <section class="page-header">
      <div class="container">
        <p class="eyebrow">Inquiry Received</p>
        <h1>Thanks for reaching out.</h1>
        <p class="page-lead">
          Your message is in my inbox. I review every inquiry personally and will follow up within one business day—or you can pick a time below if you’d like to talk sooner.
        </p>
      </div>
    </section>

    <!-- Inline Calendar & Next Steps -->
    <section class="section">
      <div class="container thanks-grid">
        <div class="info-card embed-card">
          <h2>Book a 20-Minute Intro Call</h2>
          <div class="cal-embed-wrap" id="my-cal-inline-thanks"></div>
        </div>

        <aside class="thanks-sidebar" aria-label="Next steps and operating details">
          <div class="info-card">
            <h2>What Happens Next</h2>
            <ol class="steps-list">
              <li>
                <strong>Initial Review:</strong> If you shared a website address, I’ll run a quick check on your public DNS, SSL certificate, page speed, and local listing basics before replying.
              </li>
              <li>
                <strong>Plain-English Reply:</strong> You’ll hear back from <code>jarod@maxwellwebops.com</code> within one business day with initial observations or next steps.
              </li>
              <li>
                <strong>Clear Scope Upfront:</strong> Every audit, cleanup, or ongoing management plan comes with straightforward, fixed-scope pricing before any work begins.
              </li>
            </ol>
          </div>

          <div class="info-card">
            <h2>Operating Details</h2>
            <dl class="details-list">
              <div>
                <dt>Operator</dt>
                <dd>Jarod Maxwell</dd>
              </div>
              <div>
                <dt>Location</dt>
                <dd>Fort Wayne, Indiana</dd>
              </div>
              <div>
                <dt>Hours</dt>
                <dd>Monday – Friday, 9:00 AM – 5:00 PM EST</dd>
              </div>
            </dl>
          </div>

          <a href="/" class="back-link">&larr; Return to Home</a>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ["initNamespace", namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", "20-min", { origin: "https://app.cal.com" });

  Cal.ns["20-min"]("inline", {
    elementOrSelector: "#my-cal-inline-thanks",
    config: { layout: "month_view", theme: "light" },
    calLink: "jarod-maxwell/20-min",
  });

  Cal.ns["20-min"]("ui", {
    theme: "light",
    cssVarsPerTheme: {
      light: { "cal-brand": "#1d4ed8" },
    },
    hideEventTypeDetails: false,
    layout: "month_view",
  });
</script>

<style>
  .thanks-grid {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .thanks-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.75rem;
  }

  .info-card h2 {
    font-size: 1.15rem;
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .cal-embed-wrap {
    width: 100%;
    min-height: 460px;
    overflow: auto;
  }

  .steps-list {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .steps-list strong {
    color: var(--color-text);
  }

  .steps-list code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text);
    background-color: var(--color-bg);
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
    border: 1px solid var(--color-border);
  }

  .details-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .details-list dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-bottom: 0.15rem;
  }

  .details-list dd {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .back-link {
    display: inline-block;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    align-self: flex-start;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 56rem) {
    .thanks-grid {
      grid-template-columns: 1fr;
    }
  }
</style>