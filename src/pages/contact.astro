---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Maxwell Web Ops — Fort Wayne, Indiana"
  description="Get in touch with Maxwell Web Ops for website hosting, domain administration, Google Workspace setup, or local visibility support in Fort Wayne, Indiana."
>
  <main>
    <!-- Page Header -->
    <section class="page-header">
      <div class="container">
        <p class="eyebrow">Contact</p>
        <h1>Start with a straightforward conversation.</h1>
        <p class="page-lead">
          Tell me a bit about your business, your current website, and what you need help managing. I review every inquiry personally and respond within one business day.
        </p>
      </div>
    </section>

    <!-- Contact Form & Direct Info -->
    <section class="section">
      <div class="container contact-grid">
        <form
          class="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input type="hidden" name="access_key" value="a2c0319c-9dd8-43c2-9c3d-02e1d4de01a7" />
          <input type="hidden" name="subject" value="New Inquiry — Maxwell Web Ops" />
          <input type="hidden" name="from_name" value="Maxwell Web Ops Website" />
          <input type="hidden" name="redirect" value="https://maxwellwebops.com/thanks" />
          <!-- Honeypot spam protection -->
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <div class="form-row">
            <div class="field">
              <label for="name">Your Name <span aria-hidden="true">*</span></label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                placeholder="Jane Doe"
              />
            </div>

            <div class="field">
              <label for="email">Work Email <span aria-hidden="true">*</span></label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="jane@yourbusiness.com"
              />
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label for="business">Business Name</label>
              <input
                type="text"
                id="business"
                name="business"
                autocomplete="organization"
                placeholder="Summit City Hardware"
              />
            </div>

            <div class="field">
              <label for="website">Current Website (if any)</label>
              <input
                type="text"
                id="website"
                name="website"
                placeholder="yourbusiness.com"
              />
            </div>
          </div>

          <div class="field">
            <label for="service">Primary Area of Need</label>
            <select id="service" name="service">
              <option value="Baseline Audit & Checkup">Not sure yet — Baseline Website &amp; DNS Checkup</option>
              <option value="Web Hosting & Domain Administration">Web Hosting, Domains &amp; DNS Administration</option>
              <option value="Google Workspace & Email Deliverability">Google Workspace &amp; Email Deliverability</option>
              <option value="Local Directory & Google Business Profile">Local Directory &amp; Google Business Profile</option>
              <option value="Data Hygiene & Lead Capture">Data Hygiene &amp; Smart Lead Capture</option>
              <option value="New Website Build or Migration">New Website Build or Migration</option>
            </select>
          </div>

          <div class="field">
            <label for="message">How can I help? <span aria-hidden="true">*</span></label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Share what’s currently giving you trouble, upcoming changes, or questions about your setup."
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary">Send Inquiry</button>
        </form>

        <aside class="contact-sidebar" aria-label="Direct contact details">
          <div class="info-card">
            <h2>What Happens Next</h2>
            <ol class="steps-list">
              <li>
                <strong>Baseline Look:</strong> If you included your website URL, I’ll check your public DNS, SSL, page speed, and local listing basics before replying.
              </li>
              <li>
                <strong>Clear Response:</strong> You’ll receive a plain-English reply within one business day outlining findings or scheduling a brief call.
              </li>
              <li>
                <strong>Fixed-Scope Proposal:</strong> No surprise hourly bills—every cleanup, build, or monthly plan has clear scope and pricing upfront.
              </li>
            </ol>
          </div>

          <div class="info-card">
            <h2>Direct Details</h2>
            <dl class="details-list">
              <div>
                <dt>Location</dt>
                <dd>Fort Wayne, Indiana</dd>
              </div>
              <div>
                <dt>Service Area</dt>
                <dd>Fort Wayne &amp; Northeast Indiana</dd>
              </div>
              <div>
                <dt>Hours</dt>
                <dd>Monday – Friday, 9:00 AM – 5:00 PM EST</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>

      <!-- Inline Cal.com Booking -->
      <div class="container">
        <div class="info-card booking-card" id="book">
          <div class="booking-header">
            <h2>Or Book a 20-Minute Intro Call Directly</h2>
            <p>
              Skip the form and pick a 20-minute time slot on my calendar to talk through your website, domain, or Google Workspace setup.
            </p>
          </div>
          <div class="cal-embed-wrap" id="my-cal-inline-contact"></div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ["initNamespace", namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", "20-min", { origin: "https://app.cal.com" });

  Cal.ns["20-min"]("inline", {
    elementOrSelector: "#my-cal-inline-contact",
    config: { layout: "month_view", theme: "light" },
    calLink: "jarod-maxwell/20-min",
  });

  Cal.ns["20-min"]("ui", {
    theme: "light",
    cssVarsPerTheme: {
      light: { "cal-brand": "#1d4ed8" },
    },
    hideEventTypeDetails: false,
    layout: "month_view",
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .contact-form {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
  }

  label span {
    color: var(--color-primary);
  }

  input,
  select,
  textarea {
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--color-text);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    padding: 0.65rem 0.8rem;
    width: 100%;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    background-color: var(--color-surface);
    box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.12);
  }

  textarea {
    resize: vertical;
  }

  .contact-form .btn {
    padding: 0.8rem 1.5rem;
    align-self: flex-start;
  }

  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .info-card h2 {
    font-size: 1.1rem;
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .steps-list {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 0.925rem;
    color: var(--color-text-muted);
  }

  .steps-list strong {
    color: var(--color-text);
  }

  .details-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .details-list dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-bottom: 0.15rem;
  }

  .details-list dd {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 500;
  }

  /* Inline Cal.com Booking Card */
  .booking-card {
    margin-top: 2.5rem;
    padding: 2rem;
    min-width: 0;
    overflow: hidden;
  }

  .booking-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .booking-card .booking-header h2 {
    font-size: 1.35rem;
    margin: 0 0 0.4rem;
    padding-bottom: 0;
    border-bottom: none;
  }

  .booking-header p {
    margin: 0;
    color: var(--color-text-muted);
    max-width: 44rem;
    font-size: 0.95rem;
  }

  .cal-embed-wrap {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    min-height: 460px;
    overflow-x: hidden;
  }

  .cal-embed-wrap :global(iframe) {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
  }

  @media (max-width: 52rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

@media (max-width: 36rem) {
    .form-row {
      grid-template-columns: 1fr;
    }

    .contact-form {
      padding: 1.25rem;
    }

    .booking-card {
      padding: 1.25rem 0.5rem;
    }

    .booking-header {
      padding-inline: 0.75rem;
    }
  }
</style>